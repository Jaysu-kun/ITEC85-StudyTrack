# MongoDB Atlas Connection String
ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/StudyTrack?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Task Data Encryption (AES-256-GCM 32-byte secret)
ENCRYPTION_KEY=studytrack_secret_key_32_bytes_!

# Allowed CORS Origins (comma-separated, e.g. http://localhost:5173,http://localhost:5174)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
