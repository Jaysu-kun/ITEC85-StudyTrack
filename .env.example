# ==========================================
# Backend Environment Configuration
# ==========================================

# MongoDB Atlas Connection String
ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/StudyTrack?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication (JWT Secret - required in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Task Data Encryption (AES-256-GCM 32-byte secret - required in production)
ENCRYPTION_KEY=your_32_character_encryption_key!

# Allowed CORS Origins (comma-separated; defaults include https://isko-tasks.vercel.app and localhost)
CORS_ORIGIN=https://isko-tasks.vercel.app,http://localhost:5173,http://localhost:5174

# ==========================================
# Frontend (Client) Environment Configuration
# ==========================================

# API Base URL:
# - In production on Vercel: set to your deployed backend URL (e.g., https://isko-tasks.vercel.app) or leave empty for same-origin relative calls.
# - In local development: defaults to http://localhost:3000 if omitted.
VITE_API_URL=https://isko-tasks.vercel.app

# Optional OpenWeatherMap API Key for the dashboard weather widget
VITE_OPENWEATHER_KEY=your_openweather_api_key_here
